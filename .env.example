# Copy to .env. Without DEEPSEEK_API_KEY, Comporta uses the fake provider.
PORT=8080
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
ADMIN_TOKEN=generate-a-long-random-value
DB_PATH=comporta.db
CONFIG_PATH=comporta.json
# Fake provider
FALSO_LATENCIA_MS=60
FALSO_POR_TOKEN_MS=5
FALSO_TAXA_ERRO=0
